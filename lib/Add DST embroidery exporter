import 'dart:typed_data';

/// Tajima DST embroidery exporter.
///
/// Coordinates are in 1/10 mm embroidery units.
class DstExporter {
  static Uint8List createDst(
    List<StitchPoint> stitches, {
    String name = 'KURDDESIGN',
  }) {
    final header = _createHeader(name, stitches.length);
    final data = <int>[];

    if (stitches.isEmpty) {
      data.addAll(_endCommand());
    } else {
      for (var i = 0; i < stitches.length; i++) {
        final current = stitches[i];

        if (i == 0) {
          // Move to the first point with a jump.
          data.addAll(
            _encodeMove(current.x, current.y, jump: true),
          );
        } else {
          final previous = stitches[i - 1];

          var dx = current.x - previous.x;
          var dy = current.y - previous.y;

          // Split large movements into valid DST movements.
          while (dx.abs() > 121 || dy.abs() > 121) {
            final stepX = dx.clamp(-121, 121);
            final stepY = dy.clamp(-121, 121);

            data.addAll(
              _encodeMove(
                stepX,
                stepY,
                jump: true,
              ),
            );

            dx -= stepX;
            dy -= stepY;
          }

          data.addAll(
            _encodeMove(dx, dy),
          );
        }
      }

      data.addAll(_endCommand());
    }

    return Uint8List.fromList([
      ...header,
      ...data,
    ]);
  }

  static List<int> _createHeader(
    String name,
    int stitchCount,
  ) {
    final title = name
        .replaceAll('\r', '')
        .replaceAll('\n', '')
        .padRight(16)
        .substring(0, 16);

    final headerText = [
      'LA:$title',
      'ST:${stitchCount.toString().padLeft(7, '0')}',
      'CO:${'1'.padLeft(3, '0')}',
      '+X:${'00000'}',
      '-X:${'00000'}',
      '+Y:${'00000'}',
      '-Y:${'00000'}',
      'AX:+X00000',
      'AY:+Y00000',
      'MX:+X00000',
      'MY:+Y00000',
      'PD:******',
    ].join('\r');

    final bytes = List<int>.filled(512, 0x20);

    final textBytes = headerText.codeUnits;

    for (var i = 0; i < textBytes.length && i < 511; i++) {
      bytes[i] = textBytes[i];
    }

    // DST header terminator.
    bytes[511] = 0x1A;

    return bytes;
  }

  /// Encodes one DST movement.
  static List<int> _encodeMove(
    int dx,
    int dy, {
    bool jump = false,
  }) {
    final x = dx.clamp(-121, 121);
    final y = dy.clamp(-121, 121);

    var b1 = 0;
    var b2 = 0;
    var b3 = 0x03;

    // X encoding.
    if (x >= 0) {
      b1 |= 0x01;
    } else {
      b1 |= 0x02;
    }

    // Y encoding.
    if (y >= 0) {
      b2 |= 0x01;
    } else {
      b2 |= 0x02;
    }

    final absX = x.abs();
    final absY = y.abs();

    b1 |= (absX & 0x7F) << 2;
    b2 |= (absY & 0x7F) << 2;

    // Jump flag.
    if (jump) {
      b3 |= 0x80;
    }

    return [
      b1 & 0xFF,
      b2 & 0xFF,
      b3 & 0xFF,
    ];
  }

  /// Tajima DST end-of-design command.
  static List<int> _endCommand() {
    return [
      0x00,
      0x00,
      0xF3,
    ];
  }
}

class StitchPoint {
  final int x;
  final int y;

  const StitchPoint(this.x, this.y);
}
